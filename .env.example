# Braidr — environment variables. Copy to .env.local and fill in.
# Never commit .env.local — it's already in .gitignore.
# All variables without NEXT_PUBLIC_ are server-only secrets (TRD 2.4) —
# in production these live in Netlify > Site settings > Environment variables,
# never in the repo.

# Supabase (TRD 2.4)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (TRD 2.4 / 9.0)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Anthropic (TRD 2.4 / 5.0) — server-side only, never exposed to the client
ANTHROPIC_API_KEY=

# Resend (TRD 2.4)
RESEND_API_KEY=
# Sender address — must be on a domain verified in Resend. Placeholder until
# a real domain exists; emails silently no-op (with a console warning) if
# RESEND_API_KEY is unset, so this isn't a hard blocker for local dev.
RESEND_FROM_EMAIL="Braidr <notifications@braidr.app>"

# Sentry (TRD 2.4)
SENTRY_DSN=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Additions beyond the TRD's env table, needed by code already in this repo ---

# AES-256-GCM key for encrypting braidr_pro_progress.step2_utr at the
# application layer (lib/crypto/utr.ts) — see that file's migration note.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
UTR_ENCRYPTION_KEY=

# Upstash Redis — backs the rate limiters in lib/api/rate-limit.ts (TRD 6.4).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret the Netlify scheduled functions (netlify/functions/cron-*.mjs)
# send as "Authorization: Bearer <value>" when calling /api/cron/*. Set the
# same value here and in Netlify's env vars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
